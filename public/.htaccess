# CultTwenty Agency — static site served from culttwenty.de/agency
# Uploaded into the /agency subfolder of the Strato webspace.

# Force HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Friendly 404 (Next export writes 404.html)
ErrorDocument 404 /agency/404.html
